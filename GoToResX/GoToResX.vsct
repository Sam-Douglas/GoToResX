  <Commands package="guidGoToResXPackage">

    <!-- The code editor's right-click menu. The command only shows in .razor files. -->
    <Groups>
      <Group guid="guidGoToResXCmdSet" id="EditorContextGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidGoToResXCmdSet" id="GoToResxCommand" priority="0x0100" type="Button">
        <Parent guid="guidGoToResXCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Go To ResX</ButtonText>
          <CanonicalName>.GoToResX.GoToResx</CanonicalName>
          <LocCanonicalName>.GoToResX.GoToResx</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidGoToResXPackage" value="{48679a5e-de31-41b8-a8f0-f6f767c0aece}" />

    <GuidSymbol name="guidGoToResXCmdSet" value="{a3cf9f65-46f9-44ce-9e38-89d36ab90165}">
