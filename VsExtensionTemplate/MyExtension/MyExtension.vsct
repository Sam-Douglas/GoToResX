<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidMyExtensionPackage">

    <!-- Extensions > My Extension -->
    <Menus>
      <Menu guid="guidMyExtensionCmdSet" id="ExtensionsSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>My Extension</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidMyExtensionCmdSet" id="MainGroup" priority="0x0100">
        <Parent guid="guidMyExtensionCmdSet" id="ExtensionsSubMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidMyExtensionCmdSet" id="HelloCommand" priority="0x0100" type="Button">
        <Parent guid="guidMyExtensionCmdSet" id="MainGroup" />
        <Strings>
          <ButtonText>Say Hello</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidMyExtensionPackage" value="{0f7ad5b9-c891-48fd-91ac-48bf0413e5ab}" />

    <GuidSymbol name="guidMyExtensionCmdSet" value="{cdb7a5cc-f1d9-49d9-b316-4e935e683a98}">
      <IDSymbol name="ExtensionsSubMenu" value="0x1000" />
      <IDSymbol name="MainGroup" value="0x1100" />
      <IDSymbol name="HelloCommand" value="0x0100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
